# ===== Line endings =====
# Text files are normalised to LF in the repo; git picks the binary ones itself.
* text=auto

# Unity YAML (scenes, prefabs, assets...): keep LF everywhere, as Unity writes them.
*.unity        text eol=lf
*.prefab       text eol=lf
*.asset        text eol=lf
*.mat          text eol=lf
*.meta         text eol=lf
*.anim         text eol=lf
*.controller   text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicmaterial text eol=lf
*.lighting     text eol=lf
*.renderTexture text eol=lf
*.inputactions text eol=lf
*.shadergraph  text eol=lf
*.shadersubgraph text eol=lf

# Code
*.cs     text diff=csharp
*.shader text
*.cginc  text
*.hlsl   text
*.json   text
*.txt    text
